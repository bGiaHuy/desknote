{
  "name": "desknote",
  "productName": "Desknote",
  "version": "1.0.0",
  "description": "Local desktop tasks and agenda, customized from Task Nest",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "icon": "electron build/make-icon.js",
    "test": "node verify.cjs && node verify-schedule.cjs && node verify-notifications.cjs && node verify-reminder-window.cjs && node verify-reviews.cjs && node verify-adaptive.cjs && node verify-gmail.cjs && node verify-alarm.cjs"
  },
  "author": "Task Nest",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright": "^1.65.0"
  },
  "build": {
    "appId": "local.desknote",
    "productName": "Desknote",
    "copyright": "Task Nest",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json",
      "store.js",
      "cli.js",
      "desktop_host.py",
      "agy-bridge.js",
      "agy-response.schema.json",
      "notification-engine.js",
      "reminder-window.js",
      "alarm.js",
      "alarm-preload.js",
      "review-engine.js",
      "work-planner.js",
      "inbox-client.js",
      "inbox-reader.js",
      "gmail-reader.js",
      "inbox-mcp.js",
      "read-zalo-review.py",
      "routine-policy.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Desknote",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Desknote-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "bin": {
    "desknote": "cli.js"
  }
}
